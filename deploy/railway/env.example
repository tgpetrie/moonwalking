# Required. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_ENV=production
FLASK_DEBUG=false
SERVE_FRONTEND_DIST=1
FRONTEND_DIST_DIR=/app/frontend/dist
SESSION_COOKIE_SECURE=1
# Cloudflare owns public HTTPS/security policy. Keeping Flask's redirect layer
# off avoids proxy loops and preserves the dashboard's existing inline styles.
DISABLE_TALISMAN=1
CORS_ALLOWED_ORIGINS=https://bhabit.net,https://www.bhabit.net

# Railway supplies PORT and RAILWAY_VOLUME_MOUNT_PATH automatically.
# Attach one volume at /var/lib/moonwalking. The entrypoint then keeps all
# SQLite state on that volume.
MW_DATA_DIR=/var/lib/moonwalking
PRICE_DB_RETENTION_SECONDS=86400

# Private Portfolio Mode. Add these as encrypted Railway variables. The CDP
# key must be scoped to one portfolio with View only (no Trade or Transfer).
COINBASE_PORTFOLIO_OWNER_EMAIL=
COINBASE_API_KEY_NAME=
COINBASE_API_KEY_SECRET=

# Safe operating defaults for the small always-on service.
PRICE_UNIVERSE_SAMPLE_SIZE=120
PRICE_UNIVERSE_MAX=250
VOLUME_1H_MAX_TRACKED=80
VOLUME_1H_WORKERS=4
VOLUME_1H_REFRESH_SEC=90
MW_ALERT_NOTIFY_ENABLED=0
MW_NOTIFY_MAX_PER_HOUR=6
MW_NOTIFY_SYMBOL_COOLDOWN_SECONDS=900

# Optional provider and delivery credentials.
LUNARCRUSH_API_KEY=
COINGLASS_API_KEY=
ARKHAM_API_KEY=
COINMARKETCAL_API_KEY=
MW_SMTP_HOST=
MW_SMTP_PORT=587
MW_SMTP_USERNAME=
MW_SMTP_PASSWORD=
MW_ALERT_EMAIL_FROM=
MW_ALERT_EMAIL_TO=
MW_TELEGRAM_BOT_TOKEN=
MW_TELEGRAM_CHAT_ID=
MW_DISCORD_WEBHOOK_URL=
