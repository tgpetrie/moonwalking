# Moonwalking home-server environment.
# Copy to .env next to this file, fill in SECRET_KEY, adjust paths.
# Loaded by the systemd units via EnvironmentFile.

FLASK_ENV=production

# REQUIRED in production - signs user session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Durable watchlist/account storage. Keep it OUTSIDE the repo checkout so
# `git clean`/re-clones can never touch it. Back this file up.
WATCHLIST_DB_PATH=/var/lib/moonwalking/watchlists.sqlite

# Private Portfolio Mode. Create a portfolio-specific Coinbase CDP key with
# View only. Trade and Transfer permissions cause Stage 1 to refuse startup.
COINBASE_PORTFOLIO_OWNER_EMAIL=
COINBASE_API_KEY_NAME=
COINBASE_API_KEY_SECRET=

# Serve the built frontend (frontend/dist) from the backend on one origin.
SERVE_FRONTEND_DIST=1

# Tailscale Serve terminates HTTPS in front of gunicorn, so the browser is
# on https and Secure cookies work. Set to 0 only if you access the backend
# over plain http (e.g. http://minipc:5003) - Secure cookies are never sent
# over plain http and login would silently fail.
SESSION_COOKIE_SECURE=1

# Talisman's HTTPS redirect fights plain-HTTP upstreams behind a TLS proxy;
# Tailscale provides the transport security here.
DISABLE_TALISMAN=1

# Sentiment service (moonwalking-sentiment.service)
SENTIMENT_HOST=127.0.0.1
SENTIMENT_PORT=8003

CACHE_TTL=60

# Event Evolution retention and notification delivery.
VOLUME_MINUTE_RETENTION_SECONDS=172800
VOLUME_HOURLY_RETENTION_SECONDS=7776000
MW_ALERT_NOTIFY_ENABLED=0
MW_NOTIFY_MAX_PER_HOUR=6
MW_NOTIFY_SYMBOL_COOLDOWN_SECONDS=900
MW_NOTIFY_MAX_EVENT_AGE_SECONDS=120

# Durable comparable-event grading. Each signal transition is followed for an
# hour and measured against +2% favorable before -1% adverse by default.
MW_SIGNAL_OUTCOMES_DB=/var/lib/moonwalking/signal_outcomes.sqlite
MW_OUTCOME_TARGET_PCT=2.0
MW_OUTCOME_ADVERSE_PCT=1.0
MW_OUTCOME_HORIZON_SECONDS=3600

# Generic SMTP email. Gmail SMTP can use smtp.gmail.com:587 and an app password.
MW_SMTP_HOST=
MW_SMTP_PORT=587
MW_SMTP_STARTTLS=1
MW_SMTP_SSL=0
MW_SMTP_USERNAME=
MW_SMTP_PASSWORD=
MW_ALERT_EMAIL_FROM=
MW_ALERT_EMAIL_TO=

# Optional free instant-delivery channels.
MW_TELEGRAM_BOT_TOKEN=
MW_TELEGRAM_CHAT_ID=
MW_DISCORD_WEBHOOK_URL=

# Optional licensed context providers. Coverage appears honestly as
# not_configured until credentials and a provider adapter are enabled.
LUNARCRUSH_API_KEY=
COINGLASS_API_KEY=
ARKHAM_API_KEY=
COINMARKETCAL_API_KEY=
