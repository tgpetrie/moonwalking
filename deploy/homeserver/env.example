# Moonwalking home-server environment.
# Copy to .env next to this file, fill in SECRET_KEY, adjust paths.
# Loaded by the systemd units via EnvironmentFile.

FLASK_ENV=production

# REQUIRED in production - signs user session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Durable watchlist/account storage. Keep it OUTSIDE the repo checkout so
# `git clean`/re-clones can never touch it. Back this file up.
WATCHLIST_DB_PATH=/var/lib/moonwalking/watchlists.sqlite

# Serve the built frontend (frontend/dist) from the backend on one origin.
SERVE_FRONTEND_DIST=1

# Tailscale Serve terminates HTTPS in front of gunicorn, so the browser is
# on https and Secure cookies work. Set to 0 only if you access the backend
# over plain http (e.g. http://minipc:5003) - Secure cookies are never sent
# over plain http and login would silently fail.
SESSION_COOKIE_SECURE=1

# Talisman's HTTPS redirect fights plain-HTTP upstreams behind a TLS proxy;
# Tailscale provides the transport security here.
DISABLE_TALISMAN=1

# Sentiment service (moonwalking-sentiment.service)
SENTIMENT_HOST=127.0.0.1
SENTIMENT_PORT=8003

CACHE_TTL=60
