# Local backend config. Copy to backend/.env and fill in.
# backend/.env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Option A (recommended for your own portfolio): Coinbase CDP API key
# ---------------------------------------------------------------------------
# Create a VIEW-ONLY key at https://portal.cdp.coinbase.com/access/api
# Do NOT enable Trade, Transfer, or Withdraw.
# The email must match the account you sign in to Moonwalking with.
COINBASE_PORTFOLIO_OWNER_EMAIL=
COINBASE_API_KEY_NAME=
# Paste the EC private key. Keep the literal \n escapes on one line, or wrap
# the whole PEM in double quotes across multiple lines.
COINBASE_API_KEY_SECRET=

# ---------------------------------------------------------------------------
# Option B: Coinbase OAuth (per-user "Connect Coinbase" button)
# ---------------------------------------------------------------------------
# Register an app at https://www.coinbase.com/settings/api (OAuth2 applications).
# The redirect URI must point at the Vite dev origin so the login session cookie
# survives the round trip — the /api proxy forwards it to Flask on 5003.
COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_SECRET=
COINBASE_OAUTH_REDIRECT_URI=http://localhost:5199/api/oauth/coinbase/callback

# ---------------------------------------------------------------------------
# Session signing. Any long random string. Set it so logins survive restarts.
# ---------------------------------------------------------------------------
SECRET_KEY=
