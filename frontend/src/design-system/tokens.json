{
  "$description": "Moonwalking foundations using DTCG 2025.10 token types.",
  "$extensions": {
    "com.moonwalking.meta": {
      "name": "Moonwalking Design System",
      "version": "1.0.0",
      "figmaCollections": [
        "Primitives",
        "Semantic",
        "Spacing",
        "Typography",
        "Layout",
        "Shape",
        "Motion",
        "Effects",
        "Breakpoints"
      ]
    }
  },
