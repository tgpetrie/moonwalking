      },
      "comfortable": {
        "$value": 0.14,
        "$extensions": {
          "com.moonwalking.cssVariable": "--label-tracking-comfortable",
          "com.moonwalking.cssUnit": "em",
          "com.moonwalking.figmaScope": [
            "LETTER_SPACING"
          ],
          "com.moonwalking.figmaUnit": "PERCENT"
        }
      }
    },
    "weight": {
      "$type": "number",
      "regular": {
        "$value": 400,
        "$extensions": {
          "com.moonwalking.cssVariable": "--weight-regular"
        }
      },
      "semibold": {
        "$value": 600,
        "$extensions": {
          "com.moonwalking.cssVariable": "--weight-semibold"
        }
      },
      "bold": {
        "$value": 700,
        "$extensions": {
          "com.moonwalking.cssVariable": "--weight-bold"
        }
      },
      "display": {
        "$value": 800,
        "$extensions": {
          "com.moonwalking.cssVariable": "--weight-display"
        }
