    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      },
      "$extensions": {
        "com.moonwalking.cssVariable": "--r-full",
        "com.moonwalking.figmaScope": [
          "CORNER_RADIUS"
