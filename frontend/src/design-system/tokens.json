    },
    "control": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$extensions": {
        "com.moonwalking.cssVariable": "--r-2",
        "com.moonwalking.figmaScope": [
          "CORNER_RADIUS"
        ]
      }
    },
    "surface": {
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$extensions": {
        "com.moonwalking.cssVariable": "--r-3",
        "com.moonwalking.figmaScope": [
          "CORNER_RADIUS"
        ]
      }
    },
    "raised": {
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$extensions": {
        "com.moonwalking.cssVariable": "--r-4",
        "com.moonwalking.figmaScope": [
          "CORNER_RADIUS"
        ]
