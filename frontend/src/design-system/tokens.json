  "typography": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Raleway",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "sans-serif"
        ],
        "$extensions": {
          "com.moonwalking.cssVariable": "--font-sans"
        }
      },
      "numeric": {
        "$value": "{typography.family.sans}",
        "$extensions": {
          "com.moonwalking.cssVariable": "--font-numeric"
        }
      },
      "numericLegacy": {
        "$value": "{typography.family.numeric}",
        "$description": "Compatibility alias for older components; new code uses font-numeric.",
        "$extensions": {
          "com.moonwalking.cssVariable": "--font-mono-numeric"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": {
          "value": 0.68,
          "unit": "rem"
