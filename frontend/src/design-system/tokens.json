      },
      "xl": {
        "$value": {
          "value": 1.3,
          "unit": "rem"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--text-xl"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.55,
          "unit": "rem"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--text-2xl"
        }
      },
      "3xl": {
        "$value": {
          "value": 2.1,
          "unit": "rem"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--text-3xl"
