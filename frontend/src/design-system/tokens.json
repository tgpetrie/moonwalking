      "body": {
        "$value": 1.6,
        "$extensions": {
          "com.moonwalking.cssVariable": "--leading-body",
          "com.moonwalking.figmaScope": [
            "LINE_HEIGHT"
          ],
          "com.moonwalking.figmaUnit": "PERCENT"
        }
      }
    }
  },
  "density": {
    "$type": "dimension",
    "compactX": {
      "$value": "{spacing.3}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--space-compact-x"
      }
    },
    "compactY": {
      "$value": "{spacing.2}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--space-compact-y"
      }
    },
    "comfortable": {
      "$value": "{spacing.4}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--space-comfortable"
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "sidebar": {
      "$value": {
        "value": 248,
        "unit": "px"
      },
      "$extensions": {
        "com.moonwalking.cssVariable": "--layout-sidebar-w",
        "com.moonwalking.figmaScope": [
          "WIDTH_HEIGHT"
        ]
      }
    },
    "gutter": {
      "$value": "{spacing.6}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--layout-gutter"
      }
    },
    "sectionGap": {
      "$value": "{spacing.5}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--layout-section-gap"
      }
    },
    "panelPadding": {
      "$value": "{spacing.5}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--layout-panel-pad"
      }
    },
    "gridGap": {
      "$value": "{spacing.4}",
      "$extensions": {
        "com.moonwalking.cssVariable": "--layout-grid-gap"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 160,
          "unit": "ms"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--motion-fast"
        }
      },
      "base": {
        "$value": {
          "value": 240,
          "unit": "ms"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--motion-base"
        }
      },
      "reveal": {
        "$value": {
          "value": 420,
          "unit": "ms"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--motion-reveal"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$extensions": {
          "com.moonwalking.cssVariable": "--ease-standard"
