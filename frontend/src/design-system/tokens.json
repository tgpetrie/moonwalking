        "$extensions": {
          "com.moonwalking.cssVariable": "--text-sm"
        }
      },
      "base": {
        "$value": {
          "value": 0.9,
          "unit": "rem"
        },
        "$extensions": {
          "com.moonwalking.cssVariable": "--text-base"
